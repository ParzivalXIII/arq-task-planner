# ========================================
# DATABASE CONFIGURATION
# ========================================
POSTGRES_DB=task_planner
POSTGRES_USER=user
POSTGRES_PASSWORD=password
DB_PORT=5432

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_PORT=6379

# ========================================
# APPLICATION CONFIGURATION
# ========================================
APP_PORT=8000
LOG_LEVEL=INFO
ENV=development

# ========================================
# WORKER CONFIGURATION
# ========================================
WORKER_PROCESSES=4
WORKER_REPLICAS=1
JOB_TIMEOUT=300
KEEP_RESULT=True
RESULT_TTL=3600

# ========================================
# NOTES
# ========================================
# For production: Set ENV=production and use strong passwords
# For testing (SQLite): Use DATABASE_URL=sqlite+aiosqlite:///./test.db
# For production PostgreSQL asyncpg: postgresql+asyncpg://user:password@db:5432/task_planner
# Ensure WORKER_REPLICAS matches number of worker instances needed under load
